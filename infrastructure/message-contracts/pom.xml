<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>infrastructure</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>message-contracts</artifactId>

    <!--
        서비스 사이의 메시지 계약(.avsc)만 담는 모듈. 클래스는 각 messaging 모듈이 만든다.
        호환성 검사·등록은 빌드에 걸지 않고 명시적으로 부른다.
        배경과 명령은 docs/adr/0001-message-contract-distribution.md
    -->

    <build>
        <plugins>
            <plugin>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                <version>${confluent.version}</version>
                <configuration>
                    <schemaRegistryUrls>
                        <param>${schema.registry.url}</param>
                    </schemaRegistryUrls>
                    <!-- subject 이름은 토픽명 뒤에 -value 를 붙이는 기본 규칙을 따른다 -->
                    <subjects>
                        <data-migration-request-value>
                            src/main/resources/avro/data_migration_request.avsc
                        </data-migration-request-value>
                        <data-migration-response-value>
                            src/main/resources/avro/data_migration_response.avsc
                        </data-migration-response-value>
                    </subjects>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
