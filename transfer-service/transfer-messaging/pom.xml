<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>transfer-service</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>transfer-messaging</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>kafka-producer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>kafka-consumer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>kafka-config-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                메시지 계약에서 Avro 클래스를 이 모듈이 직접 만든다.
                생성된 클래스를 jar 로 주고받으면 배포 단위만 나뉘고 빌드가 다시 묶이므로
                공유하는 것은 스키마이고 클래스는 각 모듈이 각자 만든다.
                생성물은 target 아래에 들어가므로 커밋되지 않는다.

                스키마를 어디서 얻을지는 두 가지가 있고 아래에 둘 다 적어 뒀다.

                  A. 저장소 안 계약 폴더를 읽는다            지금 쓰는 방식
                  C. 레지스트리에서 내려받는다                아래 주석

                A 는 오프라인에서 빌드되고, 같은 커밋이 항상 같은 결과를 낸다.
                C 는 스키마 원본을 저장소에 두지 않아도 되지만 레지스트리가 빌드 의존성이 된다.
                레지스트리가 죽으면 빌드가 멈추고, 그 사이 스키마가 바뀌면 같은 커밋이 다른
                결과를 낸다. 서비스 저장소를 실제로 나눠 계약 폴더에 손이 닿지 않게 되면
                그때 C 로 옮긴다.
            -->

            <!--
                C 방식. 레지스트리에서 스키마를 받아 온다.

                아래 avro-maven-plugin 보다 먼저 선언해야 한다. 같은 generate-sources
                단계에 걸린 플러그인은 pom 에 적힌 순서대로 돌기 때문이다.
                받은 파일은 subject 이름으로 저장되고, 클래스 이름은 파일명이 아니라
                스키마 안의 namespace 와 name 이 정하므로 결과는 A 와 같다.

                켜려면 아래 주석을 풀고 avro-maven-plugin 의 sourceDirectory 를
                ${project.build.directory}/avro 로 바꾼다.
                버전을 고정하지 않으면 항상 최신을 받는다는 점을 감수해야 한다.
            -->
            <!--
            <plugin>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                <version>${confluent.version}</version>
                <executions>
                    <execution>
                        <id>download-contracts</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>download</goal>
                        </goals>
                        <configuration>
                            <schemaRegistryUrls>
                                <param>${schema.registry.url}</param>
                            </schemaRegistryUrls>
                            <outputDirectory>${project.build.directory}/avro</outputDirectory>
                            <subjectPatterns>
                                <param>^data-migration-request-value$</param>
                                <param>^data-migration-response-value$</param>
                            </subjectPatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            -->

            <!-- A 방식. 저장소 안 계약 폴더를 읽는다 -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <!-- C 로 바꾸면 ${project.build.directory}/avro 로 고친다 -->
                            <sourceDirectory>${message.contracts.dir}</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                            <enableDecimalLogicalType>true</enableDecimalLogicalType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>