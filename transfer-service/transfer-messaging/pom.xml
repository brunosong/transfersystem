<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>transfer-service</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>transfer-messaging</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application-service</artifactId>
        </dependency>
        <!-- 리스너와 템플릿을 직접 쓴다. 라이브러리라 두 모듈이 각자 선언한다 -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
        </dependency>
        <!--
            계약 아티팩트. 이 jar 안에는 .avsc 만 있고 클래스는 없다.
            아래 unpack 이 꺼내 주고 avro-maven-plugin 이 그것으로 클래스를 만든다.
        -->
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>message-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                메시지 계약에서 Avro 클래스를 이 모듈이 직접 만든다.
                생성된 클래스를 jar 로 주고받으면 배포 단위만 나뉘고 빌드가 다시 묶이므로
                공유하는 것은 스키마이고 클래스는 각 모듈이 각자 만든다.
                생성물은 target 아래에 들어가므로 커밋되지 않는다.

                스키마를 어디서 얻을지는 세 가지가 있고 아래에 다 적어 뒀다.

                  A. 저장소 안 계약 폴더를 읽는다            주석
                  B. 계약 아티팩트에서 꺼낸다                지금 쓰는 방식
                  C. 레지스트리에서 내려받는다                주석

                A 는 같은 저장소일 때만 된다. 상대 경로로 닿아야 하기 때문이다.
                B 는 버전이 박히므로 재현되고, 넥서스는 이미 빌드가 의존하는 곳이라
                장애점이 새로 생기지 않는다. 계약을 다른 저장소로 떼어도 그대로 쓴다.
                C 는 원본을 저장소에 두지 않아도 되지만 레지스트리가 빌드 의존성이 된다.
                레지스트리가 죽으면 빌드가 멈추고, 버전을 고정하지 않으면 같은 커밋이
                다른 결과를 낸다.
            -->

            <!--
                B 방식. 계약 아티팩트에서 .avsc 를 꺼낸다. 지금 쓰는 방식이다.

                아래 avro-maven-plugin 보다 먼저 선언해야 한다. 같은 generate-sources
                단계에 걸린 플러그인은 pom 에 적힌 순서대로 돌기 때문이다.

                ★ 주의. unpack 은 리액터에 있는 형제 모듈이라도 아티팩트가 만들어져 있어야
                  찾는다. 그래서 이 저장소에서는 mvn install 을 한 번 돌려 둔 뒤에
                  mvn test 를 써야 한다. 계약을 다른 저장소로 떼면 넥서스에 이미 올라가
                  있으므로 이 제약이 사라진다.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-contracts</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.brunosong.transfer.system</groupId>
                                    <artifactId>message-contracts</artifactId>
                                    <version>${project.version}</version>
                                    <includes>avro/*.avsc</includes>
                                    <outputDirectory>${project.build.directory}/contracts</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                C 방식. 레지스트리에서 스키마를 받아 온다.

                아래 avro-maven-plugin 보다 먼저 선언해야 한다. 같은 generate-sources
                단계에 걸린 플러그인은 pom 에 적힌 순서대로 돌기 때문이다.
                받은 파일은 subject 이름으로 저장되고, 클래스 이름은 파일명이 아니라
                스키마 안의 namespace 와 name 이 정하므로 결과는 A 와 같다.

                켜려면 아래 주석을 풀고 avro-maven-plugin 의 sourceDirectory 를
                ${project.build.directory}/avro 로 바꾼다.
                버전을 고정하지 않으면 항상 최신을 받는다는 점을 감수해야 한다.
            -->
            <!--
            <plugin>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                <version>${confluent.version}</version>
                <executions>
                    <execution>
                        <id>download-contracts</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>download</goal>
                        </goals>
                        <configuration>
                            <schemaRegistryUrls>
                                <param>${schema.registry.url}</param>
                            </schemaRegistryUrls>
                            <outputDirectory>${project.build.directory}/avro</outputDirectory>
                            <subjectPatterns>
                                <param>^data-migration-request-value$</param>
                                <param>^data-migration-response-value$</param>
                            </subjectPatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            -->

            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <!--
                                B 는 unpack 결과를 읽는다.
                                A 로 되돌리려면 ${message.contracts.dir}
                                C 로 바꾸려면 ${project.build.directory}/avro
                            -->
                            <sourceDirectory>${project.build.directory}/contracts/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                            <enableDecimalLogicalType>true</enableDecimalLogicalType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>