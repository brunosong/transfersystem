<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>transfer-service</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>transfer-container</artifactId>

    <dependencies>
        <!--
            SchemaRegistryInitializer 가 dev 프로파일에서 classpath:avro/*.avsc 를 읽는다.
            계약 jar 에 스키마가 리소스로 들어 있으므로 의존만 걸면 클래스패스에 올라온다.
            이 jar 에는 클래스가 없으니 모델을 공유하는 것과는 다르다.
            등록의 정식 경로는 message-contracts 에서 도는 레지스트리 플러그인이고
            이쪽은 로컬에서 띄울 때 쓰는 편의 장치다.
        -->
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>message-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-dataaccess</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>saga</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <from>
                        <image>openjdk:21-jdk-slim</image> <!-- 사용할 베이스 이미지 -->
                    </from>
                    <to>
                        <image>airtrack1234/transfer-service</image>
                        <tags>
                            <tag>latest</tag>
                            <tag>${project.version}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.brunosong.transfer.system.main.TransferSystemApplication</mainClass> <!-- Spring Boot 메인 클래스 -->
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>