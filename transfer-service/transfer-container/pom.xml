<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>transfer-service</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>transfer-container</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-dataaccess</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>transfer-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>saga</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                SchemaRegistryInitializer 가 dev 프로파일에서 classpath:avro/*.avsc 를 읽는다.
                전에는 kafka-model jar 안에 그 리소스가 있었는데, 계약을 message-contracts 로
                빼면서 jar 의존을 끊었으므로 여기서 직접 복사해 넣는다.
                등록의 정식 경로는 CI 에서 도는 kafka-schema-registry-maven-plugin 이고
                이쪽은 로컬에서 띄울 때 쓰는 편의 장치다.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-message-contracts</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/avro</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${message.contracts.dir}</directory>
                                    <includes>
                                        <include>*.avsc</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <from>
                        <image>openjdk:21-jdk-slim</image> <!-- 사용할 베이스 이미지 -->
                    </from>
                    <to>
                        <image>airtrack1234/transfer-service</image>
                        <tags>
                            <tag>latest</tag>
                            <tag>${project.version}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.brunosong.transfer.system.main.TransferSystemApplication</mainClass> <!-- Spring Boot 메인 클래스 -->
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>