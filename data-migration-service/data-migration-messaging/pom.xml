<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>data-migration-service</artifactId>
        <groupId>com.brunosong.transfer.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>data-migration-messaging</artifactId>

    <dependencies>
        <!-- 리스너와 템플릿을 직접 쓴다. 라이브러리라 두 모듈이 각자 선언한다 -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
        </dependency>
        <!--
            계약 아티팩트. 이 jar 안에는 .avsc 만 있고 클래스는 없다.
            아래 unpack 이 꺼내 주고 avro-maven-plugin 이 그것으로 클래스를 만든다.
        -->
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>message-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.transfer.system</groupId>
            <artifactId>data-migration-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 계약 jar 에서 .avsc 를 꺼내고(unpack) 그것으로 Avro 클래스를 만든다.
                 설정은 루트 pom 의 pluginManagement, 배경은 docs/adr/0001 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
