<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>deployment-service</artifactId>
        <groupId>com.brunosong.deployment.system</groupId>
        <version>1.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>deployment-container</artifactId>

    <dependencies>
        <!-- 카프카 실패 처리 정책. 자동 설정이라 클래스패스에 있으면 붙는다 -->
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>kafka-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-dataaccess</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bus-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>com.brunosong.deployment.system</groupId>
            <artifactId>deployment-cache</artifactId>
        </dependency>


        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <to>
                        <image>airtrack1234/deployment-service</image>
                        <tags>
                            <tag>latest</tag>
                            <tag>${project.version}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.brunosong.deployment.system.deployment.service.DeploymentServiceApplication</mainClass> <!-- Spring Boot 메인 클래스 -->
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>